# Copy to .env for Docker Compose. Replace every placeholder before use.
POSTGRES_DB=devpilot
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=change-this-local-database-password
DEVPILOT_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional OpenAI-compatible endpoint; leave unset for deterministic-only operation.
# DEVPILOT_LLM_BASE_URL=https://provider.example/v1
# DEVPILOT_LLM_API_KEY=
# DEVPILOT_LLM_MODEL=

# Optional overrides for local non-container development.
# DEVPILOT_DATABASE_URL=sqlite:///./devpilot.db
# DEVPILOT_FRONTEND_ORIGIN=http://127.0.0.1:5173
# DEVPILOT_MAX_SOURCE_BYTES=100000
